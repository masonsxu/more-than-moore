---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HBMStack3D from '../components/viz/HBMStack3D.tsx';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Base title="首页">
  <section class="py-8">
    <p class="text-sm font-medium uppercase tracking-widest text-cyan-700">HBM Advanced Packaging · 3D</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900">More than Moore</h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600">
      HBM 先进封装-3D 封装学习笔记：TSV 堆叠、micro-bump、MR-MUF/TC-NCF/混合键合、KGD/KGSD 测试左移；2.5D/bridge 仅作堆栈的宿主环境语境。全部材料带真实链接与可信度分级。
    </p>
  </section>

  <HBMStack3D client:visible />

  <section class="mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">精排报告</h2>
      <a href="/reports/" class="text-sm text-cyan-700 hover:text-cyan-900">全部报告 →</a>
    </div>
    <div class="mt-3 grid gap-3">
      <a
        href="/reports/hbm3e-hbm4e/hbm-packaging-process.html"
        class="group block rounded-xl border border-slate-200 p-5 transition-colors hover:border-cyan-600/60 hover:bg-cyan-50/40"
      >
        <div class="flex items-baseline gap-3">
          <h3 class="font-semibold text-slate-900 group-hover:text-cyan-800">HBM 先进封装工艺图解</h3>
          <span class="text-xs text-slate-500">HBM3E → HBM4E</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">九步封装链路、WOW vs DOW、键合三工艺、KGD→KGSD 测试左移与良率难点。</p>
      </a>
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-semibold">最近笔记</h2>
      <a href="/notes/" class="text-sm text-cyan-700 hover:text-cyan-900">全部笔记 →</a>
    </div>
    <ul class="mt-4 divide-y divide-slate-100">
      {notes.map((note) => (
        <li class="py-4">
          <a href={`/notes/${note.id}/`} class="group block">
            <div class="flex items-baseline gap-3">
              <h3 class="font-medium text-slate-900 group-hover:text-cyan-800">{note.data.title}</h3>
              <time class="ml-auto text-xs text-slate-400" datetime={note.data.date.toISOString()}>
                {note.data.date.toISOString().slice(0, 10)}
              </time>
            </div>
            {note.data.description && (
              <p class="mt-1 line-clamp-2 text-sm text-slate-600">{note.data.description}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
