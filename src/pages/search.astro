---
import Base from '../layouts/Base.astro';
---

<Base title="搜索" description="站内全文搜索（Pagefind 静态索引）。">
  <section class="py-4">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">搜索</h1>
    <p class="mt-3 text-slate-600">
      搜索索引在构建时由 Pagefind 生成，需访问部署后的站点（本地可用 <code class="rounded bg-slate-100 px-1.5 py-0.5 text-[13px]">bun run build && bun run preview</code> 后打开此页）。
    </p>
    <div id="pagefind-search" class="mt-8"></div>
  </section>

  <script>
    import '@pagefind/default-ui/css/ui.css';
    import { PagefindUI } from '@pagefind/default-ui';

    new PagefindUI({
      element: '#pagefind-search',
      showImages: false,
      translations: { placeholder: '搜索笔记与报告…' },
    });
  </script>
</Base>
