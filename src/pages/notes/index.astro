---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="笔记">
  <section class="py-4">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">全部笔记</h1>
    <p class="mt-3 text-slate-600">共 {notes.length} 篇。</p>
  </section>
  <ul class="divide-y divide-slate-100">
    {notes.map((note) => (
      <li class="py-5">
        <a href={`/notes/${note.id}/`} class="group block">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 class="text-lg font-medium text-slate-900 group-hover:text-cyan-800">{note.data.title}</h2>
            <time class="text-xs text-slate-400" datetime={note.data.date.toISOString()}>
              {note.data.date.toISOString().slice(0, 10)}
            </time>
            {note.data.tags.map((tag) => (
              <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] text-slate-500">{tag}</span>
            ))}
          </div>
          {note.data.description && (
            <p class="mt-1.5 text-sm text-slate-600">{note.data.description}</p>
          )}
        </a>
      </li>
    ))}
  </ul>
</Base>
