---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'HBM 先进封装-3D 封装学习笔记：TSV 堆叠、键合工艺、混合键合、KGD/KGSD。' } = Astro.props;

const nav = [
  { href: '/', label: '首页' },
  { href: '/notes/', label: '笔记' },
  { href: '/reports/', label: '报告' },
  { href: '/structure/', label: '3D 结构' },
  { href: '/search/', label: '搜索' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · More than Moore</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen bg-white font-sans text-slate-800 antialiased">
    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur">
      <nav class="mx-auto flex max-w-4xl items-center gap-6 px-5 py-3">
        <a href="/" class="font-mono text-sm font-semibold tracking-tight text-slate-900">more-than-moore</a>
        <div class="ml-auto flex gap-5 text-sm">
          {nav.map((item) => (
            <a href={item.href} class="text-slate-600 transition-colors hover:text-cyan-700">
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-4xl px-5 py-10">
      <slot />
    </main>
    <footer class="border-t border-slate-200 py-8">
      <p class="mx-auto max-w-4xl px-5 text-sm text-slate-500">
        More than Moore · HBM 先进封装-3D 封装学习笔记 · Markdown + Astro 构建 · 部署于 Cloudflare Pages
      </p>
    </footer>
  </body>
</html>
